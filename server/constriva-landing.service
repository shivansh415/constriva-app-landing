[Unit]
Description=Update the Constriva landing page from GitHub
After=network-online.target

[Service]
Type=oneshot
User=deploy
ExecStart=/usr/local/bin/constriva-landing-update
TimeoutStartSec=120
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/constriva-landing
ProtectHome=true
PrivateTmp=true
